# Model binaries live in GitHub Releases (python scripts/models.py fetch); models/manifest.json pins them by SHA-256.
# The small readable files (model-info.json, metrics.json, manifest.json) stay in git.
/models/*.zip
/models/transformer/
/models/transformer-best/
/models/transformer-round*/

