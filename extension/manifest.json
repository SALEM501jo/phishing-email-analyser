{
  "manifest_version": 3,
  "name": "Phishing Email Analyser",
  "version": "1.0.0",
  "description": "Scores the Gmail message you're reading for phishing using a text classifier plus sender and link checks.",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*", "http://localhost:5080/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/gmail-main-world.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/extract.js", "src/banner.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Phishing Email Analyser - click for settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
