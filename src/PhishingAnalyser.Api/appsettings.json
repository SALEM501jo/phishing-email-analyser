{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ContentModel": {
    "Path": "models/phishing-content-model.zip"
  },
  "Scoring": {
    "ContentWeight": 0.9,
    "TrustVerifiedBrandSenders": true,
    "TrustEstablishedSenders": true,
    "RequireCorroboration": false
  },
  "Reputation": {
    "Enabled": true,
    "DomainAge": true,
    "ThreatFeeds": true,
    "FeedRefreshMinutes": 30,
    "SafeBrowsingApiKey": "",
    "LookupTimeoutMs": 2500
  },
  "RateLimit": {
    "PerMinute": 60
  },
  "ApiKey": ""
}
